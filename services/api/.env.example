# Recall API adapter: environment variable NAMES only.
# Copy to .env (gitignored) and fill in locally, or set them in your process manager.
# Never commit real values. Leave everything blank to run the offline fake providers.

# fake (default) | openai_compatible | hosted
RECALL_PROVIDER=
# fake (default, only when RECALL_PROVIDER=fake) | none
RECALL_TRANSCRIPTION_PROVIDER=

# OpenAI-compatible endpoint (e.g. a local model server). All three conditions are required:
# RECALL_PROVIDER=openai_compatible, RECALL_LLM_BASE_URL set, RECALL_ALLOW_REMOTE_TEXT=1
RECALL_LLM_BASE_URL=
RECALL_LLM_API_KEY=
RECALL_LLM_MODEL=
RECALL_ALLOW_REMOTE_TEXT=
RECALL_LLM_ALLOW_INSECURE_HTTP=
RECALL_LLM_TIMEOUT_S=

# Hosted commercial provider placeholder. Requires RECALL_PROVIDER=hosted,
# RECALL_HOSTED_API_KEY, RECALL_HOSTED_CONSENT=1, RECALL_HOSTED_BASE_URL and RECALL_HOSTED_MODEL.
RECALL_HOSTED_PROVIDER_NAME=
RECALL_HOSTED_BASE_URL=
RECALL_HOSTED_MODEL=
RECALL_HOSTED_API_KEY=
RECALL_HOSTED_CONSENT=

# Plain-text retention statement shown in /v1/providers for the configured remote provider.
RECALL_PROVIDER_RETENTION_NOTE=

# Comma-separated exact origins allowed by CORS (default: none).
RECALL_ALLOWED_ORIGINS=
RECALL_LOG_LEVEL=
