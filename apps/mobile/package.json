{
  "name": "@recall/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Recall for iPhone: Expo (React Native) app sharing @recall/core and @recall/content with the PWA. Standalone npm project (not a root workspace).",
  "license": "MIT",
  "main": "expo-router/entry",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "config": "expo config --type public",
    "test": "jest"
  },
  "dependencies": {
    "@expo/log-box": "^58.0.15",
    "@expo/metro-runtime": "~58.0.17",
    "@recall/content": "file:../../packages/content",
    "@recall/core": "file:../../packages/core",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  }
}
